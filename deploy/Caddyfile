labs.selena.ink {
	root * /srv/frontend-labs/current
	encode zstd gzip

	redir / /virtual-list/ 302

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	@threads path /thread-pool /thread-pool/*
	header @threads {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
	}

	@assets path /virtual-list/assets/* /task-slicer/assets/* /thread-pool/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@documents not path /virtual-list/assets/* /task-slicer/assets/* /thread-pool/assets/*
	header @documents Cache-Control no-cache

	file_server
}
