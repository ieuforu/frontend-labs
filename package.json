{
  "name": "frontend-labs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:home": "pnpm --filter frontend-labs-home dev",
    "dev:task": "pnpm --filter task-slicer-lab dev",
    "dev:threads": "pnpm --filter thread-pool-lab dev",
    "dev:canvas": "pnpm --filter infinite-canvas-core dev",
    "dev:list": "pnpm --filter virtual-list-lab dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "typescript": "~7.1.0-beta",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
